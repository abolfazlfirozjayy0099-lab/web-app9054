{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app9054",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "25891f46-4672-416a-a016-2f4aeaddacaf","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b83df217f49349b9916c7362f669f987" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
